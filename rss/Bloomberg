FdfxIU/i7wSIMXr4Q9c/v3/pidjEfPlU1QWZop3vfGKsrX.ke8XuWirGYh1PKgEw44kE/-1x-1.png" alt="" width="580"/&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style="display:none"&gt;&lt;![endif]--&gt;&lt;img alt="替代" src="https://assets.bwbx.io/images/users/iqjWHBFdfxIU/i7wSIMXr4Q9c/v3/pidjEfPlU1QWZop3vfGKsrX.ke8XuWirGYh1PKgEw44kE/-1x-1.png" style="width: 100%; display: block; margin-bottom: 4px;" /&gt;&lt;!--[if mso]&gt;&lt;/div&gt;&lt;![endif]--&gt;&lt;/a&gt; &lt;/figure&gt;&lt;hr style="border-top: 1px solid; margin-top: 24px;" /&gt;&lt;p style="margin-top: 24px; font-size: 16px;"&gt;&lt;strong style="font-size: 16px;"&gt;引起担忧的不仅仅是美国债务。&lt;/strong&gt;债券交易员加大了&lt;a href="https://links.message.bloomberg.com/a/sc/k6zTufYV9g0AuQumSAmsVVE_Z_NXoOqVI1ON41eXFQg3m2lbRcfYckS0tIHpXG2KnzlEccuEJlmazmigIbOcygBYz_uWSzyzhCFLEeicQHFMz6a7x_FmOAJpfCif36_0vy9FZWdBybkXhAEnsrC_dfrGUvLB3tr73fIRgImYceE_iosJsDO1fjOqNb1g-csXNSBAdsNJ1q14kJd4DshLBcxrEP3GyrEOSmezmQU4F9ARJE5zrUjxt5xHT40WgOuZ3ZApzYvUOezQ5hbzdCbWNXotwe0Lj4D65SvT9phk1aWzh63NOf7S4FTOxY0F9sIVn1ebTe0MuEPVHBna_VUzkzi5GzIJ1FIObyL56Z97BbA9hsHvYsrLsPDIGBVauSTkiJOGdQJEWiI9xb-xt041jN28L2mA67zshj4NWCaiyGVsVpTrto0mDMKGj8mJXDIsFpFNzv-2C1lPH06-7Qyh4HsJtcSNL7g6g_czk6g6EpSiKgVSR4mZ9TkZamQXtxAn2nboikNDTQGA17uxP_WQ9mryIwKy/hzu9rWFxpA88Qp-eP1T4Kvyfd4yOuaIF/24" rel="noopener noreferrer" style="font-size: inherit; color: #00e;" target="_blank" title="大型人工智能债务融资支持导致博通信用风险飙升"&gt;与博通相关的信用风险&lt;/a&gt;衡量力度，因为博通支持人工智能建设的巨额融资计划。&lt;/p&gt;&lt;p style="margin-top: 24px; font-size: 16px;"&gt;博通 2031 年到期的 5.15% 债券的收益率 8 月份迄今已上涨约 14 个基点。其五年期信用违约掉期的价格同期上涨了 28 个基点，增幅超过了甲骨文和 SpaceX。&lt;/p&gt;&lt;p style="margin-top: 24px; font-size: 16px;"&gt;随着科技公司投资数十亿美元扩大云计算能力，今年担保和其他形式的财务支持的使用&lt;a href="https://links.message.bloomberg.com/a/sc/gi9CymYY1EYMKZ7TcvfvYQA7ZcjY64byRFYbluDjLe5FoigUJgZFNRn6OaujKn-EhMVVNpfZf6f2HEgIWDnOXMYZsEY9ZOKYWUMnWj0pw-aonTH70NUkP6la3ygip7fyUEJ0SHwv0tMhwF2s2SBzfYQ_L7ZJ1hn5dGif7eBTNS5owrnAe9DklI5DHKNi-VCmyxk2tvn0VUFinnrWC3Z4PSnHQg1UgmhWQg8yMvOA3mhM6yBHniGyq-