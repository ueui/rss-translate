users/iqjWHBFdfxIU/ikZFMgZqREFg/v1/-1x-1.jpg" alt="Image associated with story &amp;quot;If Water Is the New Gold, We’d Better Price It Right&amp;quot;" width="580"/&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style="display:none"&gt;&lt;![endif]--&gt;&lt;img alt="与故事“如果水是新黄金，我们最好定价合理”相关的图片" src="https://assets.bwbx.io/images/users/iqjWHBFdfxIU/ikZFMgZqREFg/v1/-1x-1.jpg" style="width: 100%; display: block;" /&gt;&lt;!--[if mso]&gt;&lt;/div&gt;&lt;![endif]--&gt;&lt;/div&gt;&lt;p style="line-height: normal; margin: 12px 0 0 0; color: inherit; text-decoration: none; font-size: 14px !important;"&gt;观点&lt;/p&gt;&lt;h2 style="line-height: normal; font-weight: 700; margin: 12px 0 0 0; font-size: 20px !important;"&gt;如果水是新黄金，我们最好定价合理&lt;/h2&gt;&lt;p style="line-height: 1.4; margin: 12px 0 0 0; color: inherit; text-decoration: none; font-size: 16px !important;"&gt;如果美国以销售鸡蛋或汽油的方式销售自来水，每次消费时价格就摆在你面前，那么过去十年我们关于通货膨胀的全国性争论可能会大不相同。 &lt;/p&gt;&lt;div style="display: block; width: 100%; height: 40px; text-align: center; line-height: 40px; border: 1px solid; border-radius: 8px; margin: 16px 0 0 0; font-size: 14px !important;"&gt;阅读更多&lt;/div&gt;&lt;/div&gt;&lt;h3 style="font-size: 24px; line-height: 30px; font-weight: 700; padding-top: 12px; border-top: 1px solid; margin-top: 40px;"&gt; 🏆 绿色创新者注意了！ &lt;/h3&gt;&lt;figure style="margin: 20px 0;"&gt;&lt;!--[if mso]&gt;&lt;table width="580"&gt;&lt;tr&gt;&lt;td&gt;&lt;img src="https://assets.bwbx.io/images/users/iqjWHBFdfxIU/i3c9cWyahDcA/v0/-1x-1.png" alt="" width="580"/&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style="display:none"&gt;&lt;![endif]--&gt;&lt;img alt="" src="https://assets.bwbx.io/images/users/iqjWHBFdfxIU/i3c9cWyahDcA/v0/-1x-1.png" style="width: 100%; display: block; margin-bottom: 4px;" /&gt;&lt;!--[if mso]&gt;&lt;/div&gt;&lt;![endif]--&gt;&lt;/figure&gt;&lt;p style="margin-top: 24px; font-size: 16px;"&gt;彭博新能源财经正在寻找下一代气候技术创新者。过去 16 年来， &lt;a href="https://links.message.bloomberg.com/s/c/Joz2QjtmAAYXESfIPx3UwSTz8