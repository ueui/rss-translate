BFdfxIU/it68qtVVHc6w/v1/-1x-1.jpg" alt="Hurricane Polo off the coast of Mexico on Sept. 22. " width="580"/&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style="display:none"&gt;&lt;![endif]--&gt;&lt;img alt="9 月 22 日，飓风波罗袭击墨西哥海岸。" src="https://assets.bwbx.io/images/users/iqjWHBFdfxIU/it68qtVVHc6w/v1/-1x-1.jpg" style="width: 100%; display: block; margin-bottom: 4px;" /&gt;&lt;!--[if mso]&gt;&lt;/div&gt;&lt;![endif]--&gt;&lt;figcaption&gt;&lt;div style="font-size: 14px; line-height: 1.4;"&gt; 9 月 22 日，飓风波罗袭击墨西哥海岸。&lt;/div&gt;&lt;/figcaption&gt;&lt;div style="font-size: 14px; line-height: 1.4; font-style: italic;"&gt;资料来源：美国国家海洋和大气管理局&lt;/div&gt;&lt;/figure&gt;&lt;p style="margin-top: 24px; font-size: 16px;"&gt;飓风波罗已成为今年世界上最强的风暴之一，它可能会带来大雨和大风袭击墨西哥的太平洋海岸。波罗的最高风速达到每小时 180 英里（290 公里），使其成为萨菲尔-辛普森五级风暴的 5 级风暴。在中央压力的作用下，波罗现在是东太平洋有记录以来第二强大的系统。 &lt;/p&gt;&lt;a href="https://links.message.bloomberg.com/a/sc/JAUE82zD406M3oPlebjZOtVQH0Q89IoF62mEZg6phY3mWLAMkmpkxSNMYl98Zc11hmbZbgfWh3x-fi3eXSd401nqkktbyWOx7jg0f_WkLWaTq3UuILmOx-ckkceD0LIcDicvhtNRqOiq0OWZSLR-Z2qZyhrPAZlJ0KyJoWU5Z78AZdp1nFO4bdV0LGQiz1s9-stLbkK0BOXUQUvZfwzqt3AqACpTzBso_U_JSxyg3uhynSPyoOTz_u8XlFteKICXViw1iju3Iwy1_iIjRpVz3n5Ea5ycNwI3hI1Nm0968fIHgb4i-fUoPXrci5TwOgFmYFg4PWsgYmjQAZl5CZmyuyOWcfqM-uwQ7Kp3jsNZ7aTPDR3HpZ-ICmFpPS9ek3W82LoSAecXGjAkV7N8vSzf3jsdyI64wsjEcFXc0qQUIgZjWkki8uN59KnNxen9Xt_jc1D5pYURDWZx8St6szyuO9w8YaQviwJF7pAQASHgipE3OD6Iuazq0Y6Afe-FaxjzfNzbcnP1foH_HP61H1tfRIladGn-iOeAY4ZXaz7JbumABeopcypPmwMx/Y4Mbsvpk24LAmtCLuNj6rXZMugDjClZ1/24" rel="noopener noreferrer" style="font-size: inherit; color: #00e; text-decoration: none !important;" target="_blank" title="飓风“波罗”成为 2026 年墨西哥沿岸最强风暴之一"&gt;&lt;div style="display: block; width: 100%; height: 40px; margin: 24px 0 0 0; border: 1px solid; border-radius: 8px; text-align: center; line-height: 40px; font-size: 14px !important; color: #000 !important; text-decoration: none !important;"&gt;关注现场报道&lt;/div&gt;&lt;h3 style="font-size: 24px; line-height: 30px; font-weight: 700