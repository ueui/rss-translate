: top; padding: 20px 0px 0px;"&gt;&lt;table border="0" cellpadding="0" cellspacing="0" width="100%"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td align="left" class="text-color-adjust" style="font-size: 0px; padding: 10px 25px;"&gt;&lt;div style="font-family: 'Inter Tight', helvetica, arial, sans-serif; font-size: 22px; font-weight: bold; line-height: 30px; text-align: left; color: #000000;"&gt;我们最不需要的就是特朗普达成一项糟糕的核协议&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;!--[if mso | IE]&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;![endif]--&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;!--[if mso | IE]&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;![endif]--&gt;&lt;!-- secondary item dek --&gt;&lt;!--[if mso | IE]&gt;&lt;table align="center" border="0" cellpadding="0" cellspacing="0" class="" role="presentation" style="width:600px;" width="600" bgcolor="#FFFFFF" &gt;&lt;tr&gt;&lt;td style="line-height:0px;font-size:0px;mso-line-height-rule:exactly;"&gt;&lt;![endif]--&gt;&lt;div style="background-color: #FFFFFF; margin: 0px auto;"&gt;&lt;table align="center" border="0" cellpadding="0" cellspacing="0" style="background-color: #FFFFFF; width: 100%;"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style="direction: ltr; font-size: 0px; padding: 0; text-align: center;"&gt;&lt;!--[if mso | IE]&gt;&lt;table role="presentation" border="0" cellpadding="0" cellspacing="0"&gt;&lt;tr&gt;&lt;td class="" style="vertical-align:top;width:560px;" &gt;&lt;![endif]--&gt;&lt;div class="mj-column-px-560 mj-outlook-group-fix" style="font-size: 0px; text-align: left; direction: ltr; display: inline-block; vertical-align: top; width: 100%;"&gt;&lt;table border="0" cellpadding="0" cellspacing="0" style="background-color: #f1f2f2; vertical-align: top;" width="100%"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td align="left" class="text-color-adjust" style="font-size: 0px; padding: 10px 25px;"&gt;&lt;div style="font-family: Georgia, serif; font-size: 17px; line-height: 28px; text-align: left; color: #000000;"&gt;&lt;div class="mktoText" id="SecondaryItem2DekTextcac20fcf-7b20-495a-bd9a-05a39021c8ca"&gt;&lt;div&gt;中东一代人以来最重要的核发展现在掌握在国会手中。特朗普政府本周将与沙特阿拉伯的核协议提交给立法者审查，为该国浓缩本国反应堆燃料打开了大门……如果真的获得通过，该协议可能会在整个地区引发连锁反应，最终导致危险的军备竞赛。华盛顿应该期望阿拉伯联合酋长国、埃及和土耳其等合作伙伴为自己的计划提出类似的条件，威胁要扭转美国数十年的防扩散努力……立法者应该对此说不。 &lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;!--[if mso | IE]&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;![endif]--&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;!--[if mso | IE]&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;![endif]--&gt;&lt;!-- secondary item authors --&gt;&lt;!--[if mso | IE]&gt;&lt;table align="center" border="0" cellpadding="0" cellspacing="0" class="" role="presentation" style="width:600px;" width="600" bgcolor="#FFFFFF" &gt;&lt;tr&gt;&lt;td style="line-height:0px;font-size:0px;mso-line-height-rule:exactly;"&gt;&lt;![endif]--&gt;&lt;div style="background-color: #FFFFFF; margin: 0px auto;"&gt;&lt;table align="center" border="0" cellpadding="0" cellspacing="0" style="background-color: #FFFFFF; width: 100%;"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style="direction: ltr; font-size: 0px; padding: 0; text-align: center;"&gt;&lt;!--[if mso | IE]&gt;&lt;table role="presentation" border="0" cellpadding="0" cellspacing="0"&gt;&lt;tr&gt;&lt;td class="" style="vertical-align:top;width:560px;" &gt;&lt;![endif]--&gt;&lt;div class="mj-column-px-560 mj-outlook-group-fix" style="font-size: 0px; text-align: left; direction: ltr; display: inline-block; vertical-align: top; width: 100%;"&gt;&lt;table border="0" cellpadding="0" cellspacing="0" style="background-color: #f1f2f2; vertical-align: top;" width="100%"&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td align="left" class="text-color-adjust" style="font-size: 0px; padding: 10px 25px;"&gt;&lt;div style="font-family: Georgia, serif; font-size: 17px; line-height: 24px; text-align: left; color: #000000